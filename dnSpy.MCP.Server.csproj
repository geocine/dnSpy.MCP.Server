<Project Sdk="Microsoft.NET.Sdk.WindowsDesktop">

  <Import Project="$(MSBuildThisFileDirectory)dnSpy\DnSpyCommon.props" />

  <PropertyGroup>
    <AssemblyName>dnSpy.MCP.Server.x</AssemblyName>
    <Description>MCP Server for AI-assisted .NET assembly analysis and BepInEx plugin development</Description>
    <Copyright>Copyright (C) 2026 @chichicaste, @geocine</Copyright>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>dnSpy\dnSpy.snk</AssemblyOriginatorKeyFile>
    <OutputPath>dnSpy\dnSpy\dnSpy\bin\$(Configuration)\</OutputPath>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <CopyExtensionToRuntimeOutputs Condition="'$(CopyExtensionToRuntimeOutputs)' == ''">true</CopyExtensionToRuntimeOutputs>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
  </PropertyGroup>

  <PropertyGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <GenerateResourceUsePreserializedResources>true</GenerateResourceUsePreserializedResources>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="dnSpy\dnSpy\dnSpy.Contracts.DnSpy\dnSpy.Contracts.DnSpy.csproj" />
    <ProjectReference Include="dnSpy\dnSpy\dnSpy.Contracts.Logic\dnSpy.Contracts.Logic.csproj" />
    <ProjectReference Include="dnSpy\dnSpy\dnSpy.Contracts.Debugger\dnSpy.Contracts.Debugger.csproj" />
    <ProjectReference Include="dnSpy\dnSpy\dnSpy.Contracts.Debugger.DotNet\dnSpy.Contracts.Debugger.DotNet.csproj" />
    <ProjectReference Include="dnSpy\dnSpy\dnSpy.Contracts.Debugger.DotNet.CorDebug\dnSpy.Contracts.Debugger.DotNet.CorDebug.csproj" />
  </ItemGroup>

  <!-- de4dot integration (deobfuscation engine) — DLLs bundled in libs/ -->
  <!-- net48 build uses libs/de4dot/ (net48 DLLs) -->
  <!-- net10 build uses libs/de4dot-net8/ (net8 DLLs, compatible with net10) -->
  <ItemGroup Condition=" '$(TargetFramework)' == 'net48' ">
    <Reference Include="de4dot.code">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot\de4dot.code.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.blocks">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot\de4dot.blocks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.mdecrypt">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot\de4dot.mdecrypt.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.cui">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot\de4dot.cui.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssemblyData">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot\AssemblyData.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>
  <ItemGroup Condition=" '$(TargetFramework)' != 'net48' ">
    <Reference Include="de4dot.code">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot-net8\de4dot.code.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.blocks">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot-net8\de4dot.blocks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.mdecrypt">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot-net8\de4dot.mdecrypt.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.cui">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot-net8\de4dot.cui.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssemblyData">
      <HintPath>$(MSBuildThisFileDirectory)libs\de4dot-net8\AssemblyData.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="$(MSVSTextVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Roslyn scripting - compile-time reference only; DLL already ships with dnSpy -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <!-- For .NET Framework 4.8, we'll use a simpler HTTP listener approach -->
  <ItemGroup Condition=" '$(IsDotNetFramework)' == 'true' ">
    <PackageReference Include="Newtonsoft.Json" Version="$(NewtonsoftJsonVersion)" />
    <PackageReference Include="System.Resources.Extensions" Version="10.0.0" />
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Page Include="src\**\*.xaml" />
  </ItemGroup>

  <!-- Config file deployed alongside the DLL - user edits are preserved on rebuild -->
  <ItemGroup>
    <None Include="mcp-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="CopyNet10ExtensionToRuntimeSpecificDnSpyOutputs" AfterTargets="Build" Condition="'$(TargetFramework)' == 'net10.0-windows' and '$(CopyExtensionToRuntimeOutputs)' == 'true'">
    <ItemGroup>
      <Net10RuntimeDirs Include="$(TargetDir)win-x64\" />
      <Net10RuntimeDirs Include="$(TargetDir)win-x86\" />
      <Net10RuntimeFiles Include="$(TargetDir)dnSpy.MCP.Server.x.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)dnSpy.MCP.Server.x.pdb" Condition="Exists('$(TargetDir)dnSpy.MCP.Server.x.pdb')" />
      <Net10RuntimeFiles Include="$(TargetDir)dnSpy.MCP.Server.x.deps.json" />
      <Net10RuntimeFiles Include="$(TargetDir)mcp-config.json" />
      <Net10RuntimeFiles Include="$(TargetDir)AssemblyData.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)de4dot.blocks.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)de4dot.code.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)de4dot.cui.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)de4dot.mdecrypt.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)ModelContextProtocol.Core.dll" />
      <Net10RuntimeFiles Include="$(TargetDir)ModelContextProtocol.dll" />
    </ItemGroup>

    <MakeDir Directories="@(Net10RuntimeDirs)" />
    <Copy SourceFiles="@(Net10RuntimeFiles)" DestinationFolder="%(Net10RuntimeDirs.Identity)" SkipUnchangedFiles="true" />
  </Target>

</Project>
