<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <DnSpyRoot Condition="'$(DnSpyRoot)' == ''">$(MSBuildThisFileDirectory)..\..\hosts\dnSpy</DnSpyRoot>
    <De4dotRoot Condition="'$(De4dotRoot)' == ''">$(MSBuildThisFileDirectory)..\..\vendors\de4dotEx</De4dotRoot>
    <De4dotOutputDir Condition="'$(De4dotOutputDir)' == ''">$(MSBuildThisFileDirectory)..\..\artifacts\de4dotEx\net8\</De4dotOutputDir>
  </PropertyGroup>

  <Import Project="$(DnSpyRoot)\DnSpyCommon.props" />

  <PropertyGroup>
    <TargetFramework>net10.0-windows</TargetFramework>
    <TargetFrameworks></TargetFrameworks>
    <IsDotNetFramework>false</IsDotNetFramework>
    <IsDotNet>true</IsDotNet>
    <IsSelfContainedDotNet>true</IsSelfContainedDotNet>
    <AssemblyName>dnSpy.MCP.Server.x</AssemblyName>
    <Description>MCP Server for AI-assisted .NET assembly analysis and BepInEx plugin development</Description>
    <Copyright>Copyright (C) 2026 @chichicaste, @geocine</Copyright>
    <SignAssembly>True</SignAssembly>
    <AssemblyOriginatorKeyFile>$(DnSpyRoot)\dnSpy.snk</AssemblyOriginatorKeyFile>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <EnableDefaultPageItems>false</EnableDefaultPageItems>
    <EnableDefaultEmbeddedResourceItems>false</EnableDefaultEmbeddedResourceItems>
    <Nullable>enable</Nullable>
    <UseWPF>true</UseWPF>
    <NoWarn>$(NoWarn);NU1903</NoWarn>
    <De4dotProjectPath>$(De4dotRoot)\de4dot.cui\de4dot.cui.csproj</De4dotProjectPath>
  </PropertyGroup>

  <ItemGroup>
    <ProjectReference Include="..\dnSpy.Extension.HoLLy\dnSpy.Extension.HoLLy.Contracts\dnSpy.Extension.HoLLy.Contracts.csproj" />
    <ProjectReference Include="$(DnSpyRoot)\dnSpy\dnSpy.Contracts.DnSpy\dnSpy.Contracts.DnSpy.csproj" Private="false" />
    <ProjectReference Include="$(DnSpyRoot)\dnSpy\dnSpy.Contracts.Logic\dnSpy.Contracts.Logic.csproj" Private="false" />
    <ProjectReference Include="$(DnSpyRoot)\dnSpy\dnSpy.Contracts.Debugger\dnSpy.Contracts.Debugger.csproj" Private="false" />
    <ProjectReference Include="$(DnSpyRoot)\dnSpy\dnSpy.Contracts.Debugger.DotNet\dnSpy.Contracts.Debugger.DotNet.csproj" Private="false" />
    <ProjectReference Include="$(DnSpyRoot)\dnSpy\dnSpy.Contracts.Debugger.DotNet.CorDebug\dnSpy.Contracts.Debugger.DotNet.CorDebug.csproj" Private="false" />
  </ItemGroup>

  <ItemGroup>
    <Reference Include="de4dot.code">
      <HintPath>$(De4dotOutputDir)de4dot.code.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.blocks">
      <HintPath>$(De4dotOutputDir)de4dot.blocks.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.mdecrypt">
      <HintPath>$(De4dotOutputDir)de4dot.mdecrypt.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="de4dot.cui">
      <HintPath>$(De4dotOutputDir)de4dot.cui.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="AssemblyData">
      <HintPath>$(De4dotOutputDir)AssemblyData.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="10.0.3" />
    <PackageReference Include="Microsoft.VisualStudio.Text.UI.Wpf" Version="$(MSVSTextVersion)" />
    <PackageReference Include="ModelContextProtocol" Version="0.9.0-preview.2" />
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp" Version="5.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
    <!-- Roslyn scripting - compile-time reference only; DLL already ships with dnSpy -->
    <PackageReference Include="Microsoft.CodeAnalysis.CSharp.Scripting" Version="5.0.0">
      <ExcludeAssets>runtime</ExcludeAssets>
    </PackageReference>
  </ItemGroup>

  <ItemGroup>
    <Compile Include="src\**\*.cs" />
    <Page Include="src\**\*.xaml" />
  </ItemGroup>

  <!-- Config file deployed alongside the DLL - user edits are preserved on rebuild -->
  <ItemGroup>
    <None Include="mcp-config.json">
      <CopyToOutputDirectory>PreserveNewest</CopyToOutputDirectory>
    </None>
  </ItemGroup>

  <Target Name="BuildDe4dotLibraries" BeforeTargets="ResolveReferences">
    <Error Condition="!Exists('$(De4dotProjectPath)')" Text="de4dotEx submodule is missing. Run 'git submodule update --init --recursive'." />
    <MakeDir Directories="$(De4dotOutputDir)" />
    <Exec Command="dotnet build &quot;$(De4dotProjectPath)&quot; -c Release -f net8.0 --nologo -o &quot;$(De4dotOutputDir)&quot;" />
  </Target>

</Project>
